{
  "name": "ipl-dbms-langchain-chatbot",
  "version": "1.0.0",
  "description": "LangChain.js Text-to-SQL Chatbot for IPL DBMS with real match data insertion and query execution",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "init-db": "node -e \"import('./src/db.js').then(m => m.initDb());\"",
    "populate-db": "node populate_authentic_ipl2025.js",
    "export-to-aiven": "node src/exportToAiven.js"
  },
  "keywords": [
    "langchain",
    "sql",
    "text-to-sql",
    "ipl",
    "dbms",
    "sqlite",
    "chatbot"
  ],
  "author": "Vatsal Somaliya",
  "license": "ISC",
  "dependencies": {
    "@langchain/community": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@langchain/google-genai": "^0.1.0",
    "@langchain/groq": "^0.1.0",
    "@langchain/openai": "^0.3.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "langchain": "^0.3.0",
    "pg": "^8.23.1"
  }
}
