# ==============================================================================
# IPL 2025 DATABASE & AI WEB ENGINE CONFIGURATION (.env)
# ==============================================================================

# 1. Database Connection
# Leave empty for Local SQLite (zero-config, stored in ipl_database.sqlite).
# For Aiven PostgreSQL deployment: paste your Aiven Service URI here:
DATABASE_URL=

# 2. AI Model Provider (Choose ONE - Groq is 100% Free with 14,400 req/day at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Web Port
PORT=3000
